<?xml version="1.0" encoding="utf-8"?>
<!-- v2.3 신호 page, inside the white sheet: the new-signal banner, the permission notice,
     a small counter strip, the Bluetooth filter chips and the signal list.

     The empty-state text sits at the TOP of the list area (지훈: 빈 화면 문구는 위로). Since
     v2.3 the screen is Bluetooth only, so the chips fit on one row even at 320dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== new signal banner ===== -->
    <LinearLayout
        android:id="@+id/alertBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_v2_banner_new"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="11dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/alertTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚨 평소에 없던 새 신호가 잡혔어요"
            android:textColor="@color/v2_red"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alertBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text=""
            android:textColor="@color/v2_ink_soft"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- ===== permissions / bluetooth / location notice ===== -->
    <LinearLayout
        android:id="@+id/noticeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_v2_notice"
        android:orientation="vertical"
        android:padding="11dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/noticeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text=""
            android:textColor="@color/v2_ink_soft"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/noticeAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_v2_button_soft"
            android:paddingStart="13dp"
            android:paddingTop="6dp"
            android:paddingEnd="13dp"
            android:paddingBottom="6dp"
            android:text="설정 열기"
            android:textColor="@color/v2_blue"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The shared screen class counts each radio every refresh; the v2 sheet shows those
         numbers in the filter chips instead of a strip of its own, so the list keeps the
         room. These four views stay for the shared code to write into. -->
    <TextView
        android:id="@+id/statBle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statWifi"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statCell"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statNew"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- ===== filters: Bluetooth only (v2.3) — 전체 · 🚨 새 신호 · 📌 내 폰 연결 =====
         The Wi-Fi and 기지국 chips are gone with the radios they filtered (지훈: "와이파이랑
         기지국 안보게해주고"). Two holders are left so the shared screen class still finds
         every id it wires, and they never take room on the screen.

         v2.4 puts `📏 예상 거리` on a second row under the filters: it is a switch, not a
         filter, and on one row with the three chips it would cut `📌 내 폰 연결` off at 320dp
         (지훈: "거리도 버튼을 누르면 예상을 볼수있게 해줘"). -->
    <LinearLayout
        android:id="@+id/chipRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chipRowTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:background="@drawable/bg_v2_chip_on"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="전체"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipNew"
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_v2_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="🚨 새 신호"
                android:textColor="@color/v2_ink_soft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipBle"
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_v2_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="📌 내 폰 연결"
                android:textColor="@color/v2_ink_soft"
                android:textSize="12sp" />

            <!-- the radios this screen no longer has: kept for the shared class, never drawn -->
            <TextView
                android:id="@+id/chipWifi"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:text="와이파이"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chipCell"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:text="기지국"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipRowSecond"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <!-- v2.4: the distance switch. Off it looks like the other chips and the badges
                 read steps only; on it turns green and every badge adds `약 1.8m` beside the
                 step, in the list, the top card, the finder and the detail card. -->
            <TextView
                android:id="@+id/chipDistance"
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:background="@drawable/bg_v2_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="📏 예상 거리"
                android:textColor="@color/v2_ink_soft"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== list ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/v2SignalList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:scrollbars="none" />

        <!-- The shared screen class keeps its own adapter for the filters and the counters;
             its list is never shown in the v2 layout (the rows above are the v2 cards). -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/signalList"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <!-- Empty state: at the top of the list area, not the middle of a blank screen. -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="12dp"
            android:paddingEnd="26dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:alpha="0.30"
                android:contentDescription="@null"
                android:src="@drawable/ic_radar"
                app:tint="@color/v2_ink_soft" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="아직 잡힌 신호가 없어요"
                android:textColor="@color/v2_ink_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
