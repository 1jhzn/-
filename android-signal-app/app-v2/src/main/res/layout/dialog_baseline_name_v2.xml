<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2 name card: one text box for a 기준's name, used for a new 기준 and for renaming an
     existing one (the title, the hint and the button word change; the layout does not). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_v2_dialog"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/nameDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="새 기준 이름"
        android:textColor="@color/v2_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nameDialogHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="예: 우리 집 · 2학년 1반 · 복도"
        android:textColor="@color/v2_ink_faint"
        android:textSize="11.5sp" />

    <EditText
        android:id="@+id/nameDialogInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_v2_row"
        android:hint="이름 (비우면 ‘기준 1’처럼 자동)"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="20"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/v2_ink"
        android:textColorHint="@color/v2_ink_faint"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nameDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_v2_button_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="취소"
            android:textColor="@color/v2_ink_soft"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/nameDialogOk"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_v2_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="저장"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
