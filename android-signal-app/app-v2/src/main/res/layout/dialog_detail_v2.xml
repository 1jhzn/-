<?xml version="1.0" encoding="utf-8"?>
<!-- v2 detail card: same card as dialog_detail.xml, with the MAC address folded away behind a
     small toggle (`세부 주소 보기 ▾`) and no address in the subtitle.

     Everything else keeps the ids the shared screen class binds: title, subtitle, badges,
     scroll + body, GATT name read, direction, ignore, close. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="신호 이름"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailCloseTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp"
            android:text="✕"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="블루투스 · 제조사"
        android:textColor="@color/text_muted"
        android:textSize="10.5sp" />

    <!-- The address: folded by default, opened on a tap. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detailAddressToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:text="세부 주소 보기 ▾"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/detailAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="F8:1E:DF:12:34:56"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailBadges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge_mine"
        android:paddingStart="9dp"
        android:paddingTop="3dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3dp"
        android:text="🔗 내 폰 연결됨"
        android:textColor="#FEF3C7"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbarStyle="outsideOverlay">

        <TextView
            android:id="@+id/detailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2.5dp"
            android:text="상세 정보"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </ScrollView>

    <TextView
        android:id="@+id/detailGattResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_banner_info"
        android:lineSpacingExtra="2dp"
        android:padding="9dp"
        android:text="이름을 읽는 중"
        android:textColor="@color/amber"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detailGattButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center"
        android:text="🔍  기기 이름 더 읽어오기"
        android:textColor="@color/accent"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detailDirection"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:text="🧭  방향 찾기"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detailIgnore"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:text="📌  이 신호는 무시"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailClose"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="닫기"
        android:textColor="@color/button_on_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

</LinearLayout>
