<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1 list row, Find-My style: a soft rounded row on the white sheet with

       ( ● )   지훈의 AirPods            ┌──────────────┐
                블루투스 · 애플            │  매우 가까움  │
                                          └──────────────┘

     The circular badge on the left is coloured by radio (blue-green for Bluetooth, green for
     Wi-Fi, violet for a base station) with a white glyph; the badge on the right is the
     distance step — and, with the 📏 예상 거리 switch on, the estimate beside it
     (`매우 가까움 · 50cm 이내`), which is allowed a second line inside the same pill. It is a
     tap target of its own: pressing it flips the switch, pressing the row opens the finder.
     The MAC address never appears in the list (지훈: MAC 주소는 접어 두기) —
     itemRssi and itemBarFill stay only because the shared adapter of the other apps looks
     them up; they are not shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_v2_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="10dp"
    android:paddingBottom="9dp">

    <FrameLayout
        android:id="@+id/itemIconBox"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_v2_icon_ble">

        <ImageView
            android:id="@+id/itemIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_ble"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="제목"
            android:textColor="@color/v2_ink"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="블루투스 · 제조사"
            android:textColor="@color/v2_ink_soft"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemBadgeMine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_mine"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="🔗 내 폰 연결됨"
                android:textColor="#FEF3C7"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/itemBadgeNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_badge_new"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="🚨 새 신호"
                android:textColor="#FEE2E2"
                android:textSize="9.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/itemBadgeBoost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_badge_boost"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="세짐"
                android:textColor="#FDE68A"
                android:textSize="9.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/itemDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_v2_step_very"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="2"
        android:maxWidth="124dp"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="매우 가까움"
        android:textColor="@color/v2_emerald_deep"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <!-- Looked up by the shared adapter of the v1 screens; never drawn in v2. -->
    <TextView
        android:id="@+id/itemRssi"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:text="-70"
        android:visibility="gone" />

    <View
        android:id="@+id/itemBarFill"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
