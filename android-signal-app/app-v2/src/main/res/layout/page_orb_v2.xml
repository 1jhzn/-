<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1 신호 찾기 (orb finder).

     It opens over the whole screen from a list row or the "찾기" callout. The background
     starts at #07090B and blends to the emerald #02B95A once the signal has stayed
     '매우 가까움' for a moment; the orb in the middle grows and pulses with the level, and the
     twelve measured directions sit around it as a ring of arcs with an arrow to the strongest
     one. The step word, the direction line and the three buttons stay legible on both
     backgrounds because they are white on dark and on emerald. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orbPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_orb_dark"
    android:clickable="true"
    android:focusable="true">

    <!-- the emerald wash that fades in when the signal is in reach -->
    <View
        android:id="@+id/orbWash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/v2_emerald" />

    <LinearLayout
        android:id="@+id/orbContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/orbTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="신호 찾기"
                android:textColor="@color/v2_orb_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- v2.3: the nearness vibration switch, at the top where 지훈 asked for it.
                 The label also carries the band (2/5단계 …) so the screen says both whether
                 it will buzz and how close the signal already is. -->
            <TextView
                android:id="@+id/orbVibrate"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_v2_orb_button_on"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="📳 진동"
                android:textColor="#0A2B18"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orbClose"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_v2_orb_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="닫기"
                android:textColor="@color/v2_orb_text"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/orbSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="블루투스 · 제조사"
            android:textColor="@color/v2_orb_text_soft"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <com.jihun.signalradar.v2.V2OrbView
                android:id="@+id/orbView"
                android:layout_width="match_parent"
                android:layout_height="370dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/orbStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="보통"
            android:textColor="@color/v2_orb_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- v2.4: with `📏 예상 거리` on, the finder writes the estimate under the big step
             word (`📏 예상 약 1.8m`). Off it is not drawn at all, so the step word stays
             centred on its own. -->
        <TextView
            android:id="@+id/orbDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="📏 예상 약 1.8m"
            android:textColor="@color/v2_orb_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orbGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="폰을 평평하게 들고 천천히 한 바퀴 돌려 보세요"
            android:textColor="@color/v2_orb_text"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/orbProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="측정 진행: 0/12 방향 · 최고 – · 현재 –"
            android:textColor="@color/v2_orb_text_soft"
            android:textSize="10.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/orbDetail"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_orb_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="기기 상세"
                android:textColor="@color/v2_orb_text"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orbReset"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_orb_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="방향 다시"
                android:textColor="@color/v2_orb_text"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- v2.4: the same distance switch, so the estimate can be turned on while
                 hunting without leaving the finder (지훈: "거리도 버튼을 누르면 예상을"). -->
            <TextView
                android:id="@+id/orbDistanceToggle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_orb_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📏 예상 거리"
                android:textColor="@color/v2_orb_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
