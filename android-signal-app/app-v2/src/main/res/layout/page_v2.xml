<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1 내 주변 page: the devices inside the 10 m radar, as the same Find-My rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/nearbyCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="10m 안에 잡힌 기기 0개"
        android:textColor="@color/v2_ink_soft"
        android:textSize="11.5sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/nearbyList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="6dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/nearbyEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="10m 안에 잡힌 기기가 없어요.\n기기를 누르면 그 기기만 찾는 화면이 열려요."
            android:textColor="@color/v2_ink_faint"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
