<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The v2 shell is a bright screen: a light status bar over the pastel top area and a
         light window background, so no dark strip flashes while the app opens. -->
    <style name="Theme.SignalRadarV2" parent="Theme.SignalRadar">
        <item name="colorPrimary">@color/v2_blue</item>
        <item name="colorPrimaryDark">@color/v2_hero_top</item>
        <item name="colorAccent">@color/v2_blue</item>
        <item name="android:windowBackground">@color/v2_hero_top</item>
        <item name="android:statusBarColor">@color/v2_hero_top</item>
        <item name="android:navigationBarColor">@color/v2_sheet</item>
        <item name="android:textColorPrimary">@color/v2_ink</item>
        <item name="android:textColorSecondary">@color/v2_ink_soft</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
